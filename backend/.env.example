# Database (Supabase)
# Find this in your Supabase Dashboard: Project Settings -> Database -> Connection string -> URI
# Make sure to change 'postgresql://' to 'postgresql+asyncpg://' for SQLAlchemy async support.
# Also, append `?prepared_statement_cache_size=0` if you are using the Supabase Connection Pooler (Transaction Mode).
# Example: postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?prepared_statement_cache_size=0
DATABASE_URL=postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?prepared_statement_cache_size=0

# JWT Authentication
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Face Recognition
FACE_SIMILARITY_THRESHOLD=0.45
FACE_MODEL_NAME=buffalo_l

# Camera
CAMERA_SOURCE=0
# For RTSP/IP camera, use: rtsp://username:password@ip:port/stream

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Server
HOST=0.0.0.0
PORT=8000
